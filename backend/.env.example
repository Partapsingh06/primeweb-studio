# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/primeweb_studio

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Authentication Security
JWT_SECRET=your_jwt_secret_min_32_chars_long_placeholder
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_placeholder

# Initial Admin Setup (Used by createAdmin script if provided)
ADMIN_INITIAL_NAME="PrimeWeb Admin"
ADMIN_INITIAL_EMAIL=admin@primewebstudio.com
ADMIN_INITIAL_PASSWORD=ChangeMeNowSecure123!

# Email Provider Configuration (Optional - leave empty if not configured)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="PrimeWeb Studio <no-reply@primewebstudio.com>"

# Cloudinary Media Storage (Optional - defaults to local uploads if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
