# Frontend Environment Variables
#
# DEVELOPMENT (local):
#   Leave as /api — Vite dev server proxies /api requests to localhost:5000 automatically.
#   Copy this file to .env and keep VITE_API_URL=/api for local development.
#
# PRODUCTION (Netlify deployment):
#   Do NOT set VITE_API_URL in the committed .env file.
#   Instead, go to: Netlify Dashboard → Site Settings → Environment Variables
#   and add:
#     VITE_API_URL = https://primeweb-studio.onrender.com
#   This ensures the production build bakes in the correct backend URL.
#
VITE_API_URL=/api
